@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using System.Text
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Ödevler";
    var token = HttpContextAccessor.HttpContext?.Session.GetString("Token");
    var role = ""; var courseId = ViewBag.CourseId;
    if (!string.IsNullOrEmpty(token))
    {
        try
        {
            var payload = token.Split('.')[1].Replace('-', '+').Replace('_', '/').PadRight(token.Split('.')[1].Length + (4 - token.Split('.')[1].Length % 4) % 4, '=');
            var parsed = JsonSerializer.Deserialize<JsonElement>(Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            if (parsed.TryGetProperty("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out var roleProp)) role = roleProp.GetString() ?? "";
            else if (parsed.TryGetProperty("role", out roleProp)) role = roleProp.GetString() ?? "";
        }
        catch { }
    }
}

@if (role == "Student")
{
    <div class="container mt-4 fade-in">
        <div class="d-flex justify-content-between align-items-center mb-4"><h3 style="color:#7a6ad8; font-weight:700;"><i class="fas fa-tasks mr-2"></i>Bana Atanan Ödevler</h3></div>
        <ul class="nav nav-tabs border-0 mb-4" id="assignmentTabs" role="tablist">
            <li class="nav-item mr-4"><a class="nav-link active font-weight-bold px-4" id="active-tab" data-toggle="tab" href="#activeTab" role="tab" style="border-radius:20px; color:#1cc88a; border:1px solid #1cc88a;"><i class="fas fa-clock mr-1"></i> Aktif Ödevler</a></li>
            <li class="nav-item"><a class="nav-link font-weight-bold px-4" id="expired-tab" data-toggle="tab" href="#expiredTab" role="tab" style="border-radius:20px; color:#e74a3b; border:1px solid #e74a3b;"><i class="fas fa-exclamation-circle mr-1"></i> Süresi Geçenler</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="activeTab" role="tabpanel"><div class="row" id="studentActiveAssignmentsList"><div class="col-12 text-center py-5"><i class="fas fa-spinner fa-spin fa-2x" style="color:#1cc88a;"></i></div></div></div>
            <div class="tab-pane fade" id="expiredTab" role="tabpanel"><div class="row" id="studentExpiredAssignmentsList"></div></div>
        </div>
    </div>
}
else
{
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Ödev Yönetimi</h1>
        <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm" data-toggle="modal" data-target="#assignmentModal"><i class="fas fa-plus fa-sm text-white-50"></i> Yeni Ödev Ver</button>
    </div>
    <div class="card shadow mb-4 border-left-primary"><div class="card-body py-3"><div class="row"><div class="col-md-4 mb-2 mb-md-0"><label class="small font-weight-bold text-primary"><i class="fas fa-filter mr-1"></i>Kurs Filtresi</label><select id="courseFilterDropdown" class="form-control form-control-sm"><option value="ALL">Tüm Kurslar (Karışık)</option></select></div><div class="col-md-4 mb-2 mb-md-0"><label class="small font-weight-bold text-primary"><i class="fas fa-sort mr-1"></i>Sıralama</label><select id="sortDropdown" class="form-control form-control-sm"><option value="date_asc">Yaklaşan Teslim Tarihi (Önce)</option><option value="date_desc">Uzak Teslim Tarihi (Önce)</option><option value="title_asc">Ödev Başlığı (A-Z)</option></select></div><div class="col-md-4"><label class="small font-weight-bold text-primary"><i class="fas fa-search mr-1"></i>Arama</label><input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Ödev adında ara..."></div></div></div></div>

    <ul class="nav nav-tabs" id="adminAssignmentTabs" role="tablist">
        <li class="nav-item"><a class="nav-link active font-weight-bold text-success" id="admin-active-tab" data-toggle="tab" href="#adminActiveTab" role="tab"><i class="fas fa-clock mr-1"></i> Aktif Ödevler</a></li>
        <li class="nav-item"><a class="nav-link font-weight-bold text-danger" id="admin-expired-tab" data-toggle="tab" href="#adminExpiredTab" role="tab"><i class="fas fa-exclamation-circle mr-1"></i> Süresi Geçenler</a></li>
    </ul>

    <div class="card shadow mb-4 border-top-0">
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="adminActiveTab" role="tabpanel"><div class="table-responsive"><table class="table table-bordered table-hover align-middle mb-0" width="100%" cellspacing="0"><thead class="thead-dark"><tr><th>İlgili Kurs</th><th>Ödev Başlığı</th><th>Açıklama</th><th>Son Teslim Tarihi</th><th>Durum</th><th>İşlem</th></tr></thead><tbody id="activeAssignmentsTableBody"><tr><td colspan="6" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin mr-2"></i>Yükleniyor...</td></tr></tbody></table></div><div class="d-flex justify-content-between align-items-center mt-3 px-2"><div id="activePageInfo" class="small font-weight-bold text-muted"></div><nav aria-label="Page navigation"><ul class="pagination pagination-sm mb-0" id="activePagination"></ul></nav></div></div>
                <div class="tab-pane fade" id="adminExpiredTab" role="tabpanel"><div class="table-responsive"><table class="table table-bordered table-hover align-middle mb-0" width="100%" cellspacing="0"><thead class="thead-dark"><tr><th>İlgili Kurs</th><th>Ödev Başlığı</th><th>Açıklama</th><th>Son Teslim Tarihi</th><th>Durum</th><th>İşlem</th></tr></thead><tbody id="expiredAssignmentsTableBody"><tr><td colspan="6" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin mr-2"></i>Yükleniyor...</td></tr></tbody></table></div><div class="d-flex justify-content-between align-items-center mt-3 px-2"><div id="expiredPageInfo" class="small font-weight-bold text-muted"></div><nav aria-label="Page navigation"><ul class="pagination pagination-sm mb-0" id="expiredPagination"></ul></nav></div></div>
            </div>
        </div>
    </div>
}

@if (role == "Teacher" || role == "Admin")
{
    <div class="modal fade" id="assignmentModal" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog" role="document"><div class="modal-content"><div class="modal-header bg-primary text-white"><h5 class="modal-title">Yeni Ödev Bilgileri</h5><button type="button" class="close text-white" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body"><form id="assignmentForm"><div class="form-group"><label class="font-weight-bold">Hangi Kursa Verilecek?</label><select id="assignCourseId" class="form-control" required><option value="">Lütfen Kurs Seçin...</option></select></div><div class="form-group"><label class="font-weight-bold">Başlık</label><input type="text" id="assignTitle" class="form-control" required placeholder="Örn: 1. Vize Ödevi"></div><div class="form-group"><label class="font-weight-bold">Açıklama</label><textarea id="assignDesc" class="form-control" rows="3" required></textarea></div><div class="form-group"><label class="font-weight-bold">Son Teslim Tarihi</label><input type="datetime-local" id="assignDueDate" class="form-control" required></div><button type="submit" class="btn btn-primary btn-block" id="btnSave">Ödevi Yayınla</button></form></div></div></div></div>
    <div class="modal fade" id="editAssignmentModal" data-backdrop="static" data-keyboard="false" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog" role="document"><div class="modal-content"><div class="modal-header bg-warning text-dark"><h5 class="modal-title">Ödevi Düzenle</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body"><form id="editAssignmentForm"><input type="hidden" id="editAssignId"><input type="hidden" id="editAssignCourseId"><input type="hidden" id="editAssignRowVersion"><div class="form-group"><label class="font-weight-bold">Başlık</label><input type="text" id="editAssignTitle" class="form-control" required></div><div class="form-group"><label class="font-weight-bold">Açıklama</label><textarea id="editAssignDesc" class="form-control" rows="3" required></textarea></div><div class="form-group"><label class="font-weight-bold">Son Teslim Tarihi</label><input type="datetime-local" id="editAssignDueDate" class="form-control" required></div><button type="submit" class="btn btn-warning btn-block font-weight-bold" id="btnUpdate">Güncelle</button></form></div></div></div></div>
}

<style>
    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/locale/tr.min.js"></script>

    <script>
        const API_BASE = "https://localhost:7113/api/Assignments";
        const COURSE_API = "https://localhost:7113/api/Courses";
        const USER_ROLE = "@role";
        let CURRENT_COURSE_ID = "@courseId" !== "" ? parseInt("@courseId") : null;

        let globalAllAssignments = []; let coursesMap = {}; let courseStudentCounts = {}; let assignmentSubmissionCounts = {};
        const PAGE_SIZE = 10; let currentActiveAssignments = []; let currentExpiredAssignments = []; let activePage = 1; let expiredPage = 1;

        $(document).ready(function () {
            moment.locale('tr');
            loadInitialData();

            $("#courseFilterDropdown, #sortDropdown").on("change", applyFiltersAndRender);
            $("#searchInput").on("keyup", applyFiltersAndRender);

            if(USER_ROLE === "Student") {
                $('.nav-link').on('click', function() { $('.nav-link').css({"background-color":"transparent", "color":"#333"}); $(this).css({"background-color": $(this).attr('id') === 'active-tab' ? '#1cc88a' : '#e74a3b', "color":"#fff"}); });
                $('#active-tab').click();
            } else { handleFormSubmissions(); }
        });

        async function loadInitialData() {
            try {
                if(USER_ROLE !== "Student") { $("#activeAssignmentsTableBody, #expiredAssignmentsTableBody").html('<tr><td colspan="6" class="text-center py-4"><i class="fas fa-spinner fa-spin text-primary mr-2"></i>Veriler analiz ediliyor...</td></tr>'); }

                const courseRes = await $.ajax({ url: COURSE_API, method: "GET" });
                const courses = courseRes.data || courseRes;
                $("#courseFilterDropdown").empty().append('<option value="ALL">Tüm Kurslar (Karışık)</option>');
                $("#assignCourseId").empty().append('<option value="">Lütfen Kurs Seçin...</option>');
                courses.forEach(c => { coursesMap[c.id] = c.name; $("#courseFilterDropdown").append(`<option value="${c.id}">${c.name}</option>`); $("#assignCourseId").append(`<option value="${c.id}">${c.name}</option>`); });
                if(CURRENT_COURSE_ID) $("#courseFilterDropdown").val(CURRENT_COURSE_ID);

                if (USER_ROLE === "Student") {
                    const res = await $.ajax({ url: `${API_BASE}/student?pageNumber=1&pageSize=1000`, method: "GET" });
                    let assignments = res.data || res || [];
                    const subRes = await $.ajax({ url: `https://localhost:7113/api/Submissions/student?pageNumber=1&pageSize=1000`, method: "GET" }).catch(() => ({ data: [] }));
                    const submissions = subRes.data || subRes || [];
                    const submittedIds = submissions.map(s => s.assignmentId || s.id);
                    globalAllAssignments = assignments.map(a => { if(submittedIds.includes(a.id)) { a.isSubmitted = true; } return a; });
                } else {
                    const fetchPromises = courses.map(c => $.ajax({ url: `${API_BASE}/course/${c.id}?pageNumber=1&pageSize=1000`, method: "GET" }).catch(() => ({ data: [] })));
                    const results = await Promise.all(fetchPromises);
                    globalAllAssignments = [];
                    results.forEach(res => { const list = res.data || res; if(Array.isArray(list)) globalAllAssignments.push(...list); });
                    await fetchManagementData(courses);
                }
                applyFiltersAndRender();
            } catch (err) {
                console.log(err);
                if(USER_ROLE !== "Student") $("#activeAssignmentsTableBody, #expiredAssignmentsTableBody").html('<tr><td colspan="6" class="text-center text-danger">Veriler toplanırken hata oluştu!</td></tr>');
            }
        }

        async function fetchManagementData(courses) {
            const studentCountPromises = courses.map(c => $.ajax({ url: `${COURSE_API}/${c.id}/students`, method: "GET" }).then(st => { courseStudentCounts[c.id] = (st.data || st).length; }).catch(() => { courseStudentCounts[c.id] = 0; }) );
            const submissionCountPromises = globalAllAssignments.map(a => $.ajax({ url: `https://localhost:7113/api/Submissions/assignment/${a.id}`, method: "GET" }).then(sub => { assignmentSubmissionCounts[a.id] = (sub.data || sub).length; }).catch(() => { assignmentSubmissionCounts[a.id] = 0; }) );
            await Promise.all([...studentCountPromises, ...submissionCountPromises]);
        }

        function applyFiltersAndRender() {
            let filtered = [...globalAllAssignments];
            if(USER_ROLE !== "Student") {
                const selectedCourse = $("#courseFilterDropdown").val(); if (selectedCourse !== "ALL" && selectedCourse !== undefined) filtered = filtered.filter(a => a.courseId === parseInt(selectedCourse));
                const searchText = $("#searchInput").val(); if (searchText) { const lowerSearch = searchText.toLowerCase(); filtered = filtered.filter(a => a.title.toLowerCase().includes(lowerSearch) || a.description.toLowerCase().includes(lowerSearch)); }
            }
            const sortBy = $("#sortDropdown").val();
            filtered.sort((a, b) => {
                if (sortBy === "date_asc") return new Date(a.dueDate) - new Date(b.dueDate);
                if (sortBy === "date_desc") return new Date(b.dueDate) - new Date(a.dueDate);
                if (sortBy === "title_asc") return a.title.localeCompare(b.title);
                return 0;
            });
            const now = moment();
            currentActiveAssignments = filtered.filter(a => moment(a.dueDate).isSameOrAfter(now));
            currentExpiredAssignments = filtered.filter(a => moment(a.dueDate).isBefore(now));
            activePage = 1; expiredPage = 1;
            if(USER_ROLE === "Student") { renderStudentCards(currentActiveAssignments, "#studentActiveAssignmentsList", true); renderStudentCards(currentExpiredAssignments, "#studentExpiredAssignmentsList", false); }
            else { renderActivePage(); renderExpiredPage(); }
        }

        function renderStudentCards(data, containerId, isActive) {
            let html = "";
            if (data.length === 0) { html = `<div class="col-12 text-center text-muted py-4">Bu kategoride ödev bulunmuyor.</div>`; }
            else {
                data.forEach(item => {
                    const dateText = new Date(item.dueDate).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' });
                    const courseName = coursesMap[item.courseId] || "Bilinmeyen Kurs"; const color = isActive ? "#1cc88a" : "#e74a3b";
                    const statusBadge = item.isSubmitted ? `<span class="badge badge-success px-3 py-2">Teslim Edildi</span>` : (!isActive ? `<span class="badge badge-danger px-3 py-2">Süresi Bitti</span>` : `<span class="badge badge-warning text-dark px-3 py-2">Bekliyor</span>`);
                    const actionBtn = item.isSubmitted ? `<a href="/Submissions" class="btn btn-sm btn-outline-secondary btn-block mt-3" style="border-radius:20px;"><i class="fas fa-check"></i> Teslim Edildi (Notlarımı Gör)</a>` : (!isActive ? `<button class="btn btn-sm btn-secondary btn-block mt-3" style="border-radius:20px;" disabled>Süre Bitti</button>` : `<a href="/Submissions?assignmentId=${item.id}" class="btn btn-sm text-white btn-block mt-3" style="background-color:#7a6ad8; border-radius:20px;">Şimdi Teslim Et</a>`);
                    html += `<div class="col-lg-6 mb-4 fade-in"><div class="card h-100 border-0 shadow-sm" style="border-radius:15px; border-left: 5px solid ${color} !important;"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><span class="badge px-3 py-2" style="background-color:rgba(122,106,216,0.1); color:#7a6ad8;">${courseName}</span>${statusBadge}</div><h5 class="font-weight-bold text-dark">${item.title}</h5><p class="text-muted small mt-2" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">${item.description}</p><div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center"><div class="small font-weight-bold" style="color:${color};"><i class="fas fa-clock mr-1"></i> Son: ${dateText}</div></div>${actionBtn}</div></div></div>`;
                });
            }
            $(containerId).html(html);
        }

        function renderActivePage() {
            const total = currentActiveAssignments.length; const totalPages = Math.ceil(total / PAGE_SIZE) || 1; const start = (activePage - 1) * PAGE_SIZE;
            renderTableData(currentActiveAssignments.slice(start, start + PAGE_SIZE), "#activeAssignmentsTableBody", true); renderPaginationControls(total, activePage, totalPages, "active");
        }
        function renderExpiredPage() {
            const total = currentExpiredAssignments.length; const totalPages = Math.ceil(total / PAGE_SIZE) || 1; const start = (expiredPage - 1) * PAGE_SIZE;
            renderTableData(currentExpiredAssignments.slice(start, start + PAGE_SIZE), "#expiredAssignmentsTableBody", false); renderPaginationControls(total, expiredPage, totalPages, "expired");
        }
        function changePage(tab, page) { if (tab === 'active') { activePage = page; renderActivePage(); } else { expiredPage = page; renderExpiredPage(); } }
        function renderPaginationControls(totalCount, currentPage, totalPages, tab) {
            const container = tab === "active" ? "#activePagination" : "#expiredPagination"; const infoContainer = tab === "active" ? "#activePageInfo" : "#expiredPageInfo";
            if (totalCount === 0) { $(container).html(""); $(infoContainer).text(""); return; }
            let html = `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="changePage('${tab}', ${currentPage - 1})">Önceki</a></li>`;
            for (let i = 1; i <= totalPages; i++) { html += `<li class="page-item ${i === currentPage ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="changePage('${tab}', ${i})">${i}</a></li>`; }
            html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="changePage('${tab}', ${currentPage + 1})">Sonraki</a></li>`;
            $(container).html(html);
            const startItem = (currentPage - 1) * PAGE_SIZE + 1; const endItem = Math.min(currentPage * PAGE_SIZE, totalCount);
            $(infoContainer).text(`Toplam ${totalCount} ödevden ${startItem}-${endItem} arası gösteriliyor.`);
        }
        function renderTableData(assignments, targetTbody, isActive) {
            if (assignments.length === 0) { $(targetTbody).html('<tr><td colspan="6" class="text-center text-muted py-4">Kriterlere uygun ödev bulunamadı.</td></tr>'); return; }
            let html = "";
            assignments.forEach(item => {
                const dateText = new Date(item.dueDate).toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' });
                const courseName = coursesMap[item.courseId] || "Bilinmeyen Kurs";
                const dateBadge = !isActive ? `<span class="text-danger font-weight-bold"><i class="fas fa-clock mr-1"></i>${dateText} (Bitti)</span>` : `<span class="text-success font-weight-bold"><i class="fas fa-clock mr-1"></i>${dateText}</span>`;
                const submitted = assignmentSubmissionCounts[item.id] || 0; const total = courseStudentCounts[item.courseId] || 0;
                const colorClass = submitted === total && total > 0 ? "badge-success" : (submitted === 0 ? "badge-danger" : "badge-info");
                const statusHtml = `<span class="badge ${colorClass} px-3 py-2" style="font-size: 1rem;"><i class="fas fa-user-check mr-1"></i> ${submitted} / ${total}</span>`;
                html += `<tr><td><span class="badge badge-primary p-2">${courseName}</span></td><td><strong class="text-dark">${item.title}</strong></td><td class="text-muted small">${item.description}</td><td>${dateBadge}</td><td class="text-center">${statusHtml}</td><td><a href="/Submissions?assignmentId=${item.id}" class="btn btn-sm btn-info text-white mr-1" title="Teslimleri Gör"><i class="fas fa-eye"></i></a> <button class="btn btn-sm btn-warning text-dark mr-1" onclick="openEditModal(${item.id})"><i class="fas fa-edit"></i></button> <button class="btn btn-sm btn-danger" onclick="deleteAssignment(${item.id})"><i class="fas fa-trash"></i></button></td></tr>`;
            });
            $(targetTbody).hide().html(html).fadeIn(200);
        }

        function handleFormSubmissions() {
            $("#assignmentForm").on("submit", function (e) { e.preventDefault(); const data = { title: $("#assignTitle").val(), description: $("#assignDesc").val(), dueDate: $("#assignDueDate").val(), courseId: parseInt($("#assignCourseId").val()) }; $.ajax({ url: API_BASE, method: "POST", contentType: "application/json", data: JSON.stringify(data), beforeSend: function () { $("#btnSave").prop("disabled", true).text("Yayınlanıyor..."); }, success: function () { $("#assignmentModal").modal("hide"); $("#assignmentForm")[0].reset(); Swal.fire('Başarılı', 'Ödev yayınlandı.', 'success'); loadInitialData(); }, error: function (err) { let msg = "Hata oluştu."; if (err.responseJSON) msg = err.responseJSON.message || err.responseJSON.detail; Swal.fire('Hata', msg, 'error'); }, complete: function () { $("#btnSave").prop("disabled", false).text("Ödevi Yayınla"); }}); });
            $("#editAssignmentForm").on("submit", function (e) { e.preventDefault(); const id = parseInt($("#editAssignId").val()); const data = { id: id, title: $("#editAssignTitle").val(), description: $("#editAssignDesc").val(), dueDate: $("#editAssignDueDate").val(), courseId: parseInt($("#editAssignCourseId").val()), rowVersion: $("#editAssignRowVersion").val() }; $.ajax({ url: `${API_BASE}/${id}`, method: "PUT", contentType: "application/json", data: JSON.stringify(data), beforeSend: function () { $("#btnUpdate").prop("disabled", true).text("Güncelleniyor..."); }, success: function () { $("#editAssignmentModal").modal("hide"); Swal.fire('Başarılı', 'Ödev güncellendi.', 'success'); loadInitialData(); }, error: function (err) { let msg = "Hata oluştu."; if (err.responseJSON) msg = err.responseJSON.message || err.responseJSON.detail; Swal.fire('Hata', msg, 'error'); }, complete: function () { $("#btnUpdate").prop("disabled", false).text("Güncelle"); }}); });
        }
        function openEditModal(id) { const assignment = globalAllAssignments.find(a => a.id === id); if (assignment) { $("#editAssignId").val(assignment.id); $("#editAssignTitle").val(assignment.title); $("#editAssignDesc").val(assignment.description); $("#editAssignCourseId").val(assignment.courseId); $("#editAssignRowVersion").val(assignment.rowVersion); const date = new Date(assignment.dueDate); const localISOTime = (new Date(date - date.getTimezoneOffset() * 60000)).toISOString().slice(0, 16); $("#editAssignDueDate").val(localISOTime); $("#editAssignmentModal").modal("show"); } }
        function deleteAssignment(id) { Swal.fire({ title: 'Emin misiniz?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#e74a3b', confirmButtonText: 'Sil' }).then((result) => { if (result.isConfirmed) { $.ajax({ url: `${API_BASE}/${id}`, method: "DELETE", success: function() { Swal.fire('Silindi','','success'); loadInitialData(); }}); }}); }
    </script>
}