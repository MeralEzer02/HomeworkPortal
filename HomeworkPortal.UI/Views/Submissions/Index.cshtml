@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using System.Text
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Notlarım";
    var token = HttpContextAccessor.HttpContext?.Session.GetString("Token");
    var role = "";
    if (!string.IsNullOrEmpty(token))
    {
        try
        {
            var payload = token.Split('.')[1].Replace('-', '+').Replace('_', '/').PadRight(token.Split('.')[1].Length + (4 - token.Split('.')[1].Length % 4) % 4, '=');
            var parsed = JsonSerializer.Deserialize<JsonElement>(Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            if (parsed.TryGetProperty("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out var roleProp)) role = roleProp.GetString() ?? "";
            else if (parsed.TryGetProperty("role", out roleProp)) role = roleProp.GetString() ?? "";
        }
        catch { }
    }
}

@if (role == "Student")
{
    <div class="container mt-4 fade-in">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 style="color:#7a6ad8; font-weight:700;"><i class="fas fa-check-circle mr-2"></i>Notlarım ve İlerleme</h3>
            <button type="button" class="btn text-white font-weight-bold shadow-sm px-4 py-2" data-toggle="modal" data-target="#uploadModal" onclick="loadAssignmentsForUpload()" style="background-color:#1cc88a; border-radius:30px;">
                <i class="fas fa-upload mr-2"></i> Yeni Ödev Teslim Et
            </button>
        </div>
        <div class="row" id="studentSubmissionsList"><div class="col-12 text-center py-5"><i class="fas fa-spinner fa-spin fa-3x" style="color:#7a6ad8;"></i></div></div>
    </div>
}
else
{
    <div class="d-sm-flex align-items-center justify-content-between mb-4"><h1 class="h3 mb-0 text-gray-800">Teslim Yönetim Merkezi</h1></div>
    <div class="card shadow mb-4 fade-in"><div class="card-body p-0"><div class="table-responsive"><table class="table table-bordered table-hover align-middle mb-0" width="100%" cellspacing="0"><thead class="thead-dark"><tr><th>Öğrenci Adı</th><th>Ders ve Ödev Bilgisi</th><th class="text-center">Dosya</th><th>Öğrenci Notu (Açıklama)</th><th>Teslim Tarihi</th><th class="text-center">Durum / Puan</th><th class="text-center">İşlem</th></tr></thead><tbody id="submissionTableBody"><tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin fa-2x mb-3"></i></td></tr></tbody></table></div></div></div>
}

@if (role == "Student")
{
    <div class="modal fade" id="uploadModal" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content border-0 shadow-lg" style="border-radius:20px;"><div class="modal-header border-0" style="background-color:#7a6ad8; color:white; border-radius:20px 20px 0 0;"><h5 class="modal-title font-weight-bold"><i class="fas fa-file-upload mr-2"></i>Ödev Yükle</h5><button type="button" class="close text-white" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body bg-light p-4"><form id="uploadForm"><div class="form-group"><label class="font-weight-bold text-dark">Ödev Seçin</label><select id="uploadAssignmentId" class="form-control" style="border-radius:10px;" required><option value="">Yükleniyor...</option></select></div><div class="form-group mt-3"><label class="font-weight-bold text-dark">Dosya Ekle</label><input type="file" id="uploadFile" class="form-control-file p-2 border bg-white" style="border-radius:10px;" accept=".pdf,.doc,.docx,.zip,.rar,.png,.jpg,.jpeg" required><small class="text-muted d-block mt-2"><i class="fas fa-info-circle mr-1"></i>Kabul edilen formatlar: <b>PDF, DOCX, ZIP, RAR, PNG, JPG</b></small></div><div class="form-group mt-3"><label class="font-weight-bold text-dark">Açıklama / Öğretmene Not</label><textarea id="uploadNote" class="form-control" rows="2" style="border-radius:10px;"></textarea></div><button type="submit" class="btn text-white btn-block font-weight-bold btn-lg mt-4" id="btnUploadSubmit" style="background-color:#1cc88a; border-radius:20px;"><i class="fas fa-paper-plane mr-2"></i> Yükle</button></form></div></div></div></div>
}
else
{
    <div class="modal fade" id="gradeModal" data-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-warning text-dark border-0"><h5 class="modal-title font-weight-bold"><i class="fas fa-star mr-2"></i>Ödevi Değerlendir</h5><button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body bg-light p-4"><form id="gradeForm"><input type="hidden" id="gradeSubmissionId"><div class="form-group"><label class="font-weight-bold text-dark">Verilecek Not (0-100)</label><input type="number" id="gradeValue" class="form-control form-control-lg text-center font-weight-bold" required min="0" max="100"></div><div class="form-group mt-3"><label class="font-weight-bold text-dark">Geri Bildirim (Opsiyonel)</label><textarea id="gradeFeedback" class="form-control" rows="3"></textarea></div><button type="submit" class="btn btn-warning btn-block font-weight-bold btn-lg mt-4 shadow-sm" id="btnGradeSubmit">Puanı Kaydet</button></form></div></div></div></div>
}

<style>
    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script>
        const API_BASE = "https://localhost:7113/api";
        const USER_ROLE = "@role";
        let globalSubmissions = [];
        let globalSubmittedAssignmentIds = [];

        $(document).ready(function () {
            if (USER_ROLE === "Student") {
                loadStudentSubmissions();
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('assignmentId')) { loadAssignmentsForUpload(urlParams.get('assignmentId')); $('#uploadModal').modal('show'); }
                handleUploadForm();
            } else { loadSubmissions(1); handleGradeForm(); }
        });

        function loadStudentSubmissions() {
            $.ajax({
                url: `${API_BASE}/Submissions/student?pageNumber=1&pageSize=100`, method: "GET",
                success: function (res) {
                    const data = res.data || res || []; let html = "";

                    globalSubmittedAssignmentIds = data.map(s => s.assignmentId || s.id);

                    if(data.length === 0) { html = `<div class="col-12 text-center text-muted py-5">Henüz ödev teslim etmediniz.</div>`; }
                    else {
                        data.forEach(item => {
                            const dateText = moment.utc(item.submissionDate || item.submittedAt).local().format('DD.MM.YYYY HH:mm');
                            const badge = item.grade !== null && item.grade !== undefined ? `<span class="badge badge-success px-3 py-2" style="font-size:1rem;">Not: ${item.grade}</span>` : `<span class="badge badge-warning text-dark px-3 py-2">Değerlendiriliyor...</span>`;
                            const fileLink = item.filePath ? `<a href="https://localhost:7113/${item.filePath}" target="_blank" class="btn btn-sm btn-outline-primary" style="border-radius:20px;"><i class="fas fa-download mr-1"></i>İndir</a>` : '';
                            html += `<div class="col-12 mb-3 fade-in"><div class="card border-0 shadow-sm" style="border-radius:15px; border-left: 5px solid #7a6ad8 !important;"><div class="card-body d-flex justify-content-between align-items-center"><div><span class="badge mb-2" style="background-color:rgba(122,106,216,0.1); color:#7a6ad8;">${item.courseName || 'Kurs'}</span><h5 class="font-weight-bold text-dark mb-1">${item.assignmentTitle}</h5><small class="text-muted"><i class="fas fa-calendar-check mr-1"></i>Teslim: ${dateText}</small></div><div class="text-right"><div class="mb-2">${badge}</div>${fileLink}</div></div></div></div>`;
                        });
                    }
                    $("#studentSubmissionsList").html(html);
                }
            });
        }

        function loadAssignmentsForUpload(preSelectId = null) {
            $.ajax({ url: `${API_BASE}/Assignments/for-upload`, method: "GET", success: function(res) {
                let html = '<option value="">Lütfen listeden seçiniz...</option>';
                const data = res.data || res || [];

                const unsubmittedData = data.filter(a => !globalSubmittedAssignmentIds.includes(a.id));

                if (unsubmittedData.length === 0) {
                    html = '<option value="">Teslim edilecek yeni ödeviniz yok.</option>';
                    $("#btnUploadSubmit").prop("disabled", true);
                } else {
                    $("#btnUploadSubmit").prop("disabled", false);
                    unsubmittedData.forEach(a => { html += `<option value="${a.id}">${a.title}</option>`; });
                }

                $("#uploadAssignmentId").html(html);

                if(preSelectId && !globalSubmittedAssignmentIds.includes(parseInt(preSelectId))) {
                    $("#uploadAssignmentId").val(preSelectId);
                }
            }});
        }

        function handleUploadForm() {
            $("#uploadForm").on("submit", function (e) {
                e.preventDefault();
                let formData = new FormData(); formData.append("AssignmentId", $("#uploadAssignmentId").val()); formData.append("File", $("#uploadFile")[0].files[0]);
                if ($("#uploadNote").val()) formData.append("StudentNote", $("#uploadNote").val());
                let btn = $("#btnUploadSubmit"); btn.prop("disabled", true).html('Yükleniyor...');
                $.ajax({ url: `${API_BASE}/Submissions`, method: "POST", data: formData, processData: false, contentType: false,
                    success: function () { $("#uploadModal").modal("hide"); Swal.fire('Başarılı', 'Ödev teslim edildi!', 'success'); loadStudentSubmissions(); $("#uploadForm")[0].reset(); window.history.replaceState(null, null, window.location.pathname); },
                    error: function (err) { let errMsg = "Dosya yüklenirken bir sorun oluştu."; if(err.responseJSON) { if(err.responseJSON.message) errMsg = err.responseJSON.message; else if(err.responseJSON.detail) errMsg = err.responseJSON.detail; } Swal.fire('Yükleme Başarısız', errMsg, 'error'); },
                    complete: function () { btn.prop("disabled", false).html('<i class="fas fa-paper-plane mr-2"></i> Yükle'); }
                });
            });
        }

        function loadSubmissions(page) {
            $.ajax({ url: `${API_BASE}/Submissions/all?pageNumber=${page}&pageSize=50`, method: "GET", success: function (res) {
                globalSubmissions = res.data || res || []; let html = "";
                if (globalSubmissions.length === 0) { html = `<tr><td colspan="7" class="text-center text-muted py-5">Teslim bulunamadı.</td></tr>`; }
                else {
                    globalSubmissions.forEach(item => {
                        const dateText = moment.utc(item.submissionDate || item.submittedAt).local().format('DD.MM.YYYY HH:mm');
                        let gradeHtml = item.grade !== null && item.grade !== undefined ? `<span class="badge badge-success px-3 py-2">Not: ${item.grade}</span>` : `<span class="badge badge-warning text-dark px-3 py-2">Not Bekliyor</span>`;
                        const fileLink = item.filePath ? `<a href="https://localhost:7113/${item.filePath}" target="_blank" class="btn btn-sm btn-info text-white"><i class="fas fa-download"></i></a>` : '-';
                        html += `<tr><td><strong class="text-dark">${item.studentFullName || 'Öğrenci'}</strong></td><td><div class="small text-primary font-weight-bold mb-1">${item.courseName || 'Kurs'}</div><div class="text-dark">${item.assignmentTitle || 'Ödev'}</div></td><td class="text-center">${fileLink}</td><td class="text-muted small">${item.studentNote || item.feedback || '-'}</td><td>${dateText}</td><td class="text-center">${gradeHtml}</td><td class="text-center"><button class="btn btn-sm btn-warning font-weight-bold shadow-sm" onclick="openGradeModal(${item.id})"><i class="fas fa-star mr-1"></i>Puan Ver</button></td></tr>`;
                    });
                }
                $("#submissionTableBody").html(html);
            }});
        }
        function openGradeModal(id) { const sub = globalSubmissions.find(s => s.id === id); if (sub) { $("#gradeSubmissionId").val(sub.id); $("#gradeValue").val(sub.grade || ''); $("#gradeFeedback").val(sub.feedback || ''); $("#gradeModal").modal("show"); } }
        function handleGradeForm() { $("#gradeForm").on("submit", function (e) { e.preventDefault(); const subId = $("#gradeSubmissionId").val(); const data = { grade: parseInt($("#gradeValue").val()), feedback: $("#gradeFeedback").val() }; $.ajax({ url: `${API_BASE}/Submissions/${subId}/grade`, method: "POST", contentType: "application/json", data: JSON.stringify(data), success: function () { $("#gradeModal").modal("hide"); Swal.fire('Başarılı!', 'Not kaydedildi.', 'success'); loadSubmissions(1); }}); }); }
    </script>
}