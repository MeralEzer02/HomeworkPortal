@{
    ViewData["Title"] = "Ödev Teslimleri";
    var role = ViewBag.Role as string;
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-check-square mr-2 text-primary"></i>Teslim Yönetim Merkezi
    </h1>

    @if (role == "Student")
    {
        <button class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm" id="btnOpenUploadModal">
            <i class="fas fa-upload fa-sm text-white-50 mr-2"></i> Ödev Yükle
        </button>
    }
</div>

<div class="card shadow mb-4 border-left-primary fade-in">
    <div class="card-header py-3 bg-white">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-filter mr-2"></i>Filtrele ve Ara</h6>
    </div>
    <div class="card-body bg-light py-3">
        <div class="row">
            <div class="col-md-3 mb-3 mb-md-0">
                <label class="small font-weight-bold text-gray-700">Ders Seçimi</label>
                <select id="filterCourse" class="form-control form-control-sm">
                    <option value="">Tüm Dersler</option>
                </select>
            </div>

            <div class="col-md-3 mb-3 mb-md-0">
                <label class="small font-weight-bold text-gray-700">Değerlendirme Durumu</label>
                <select id="filterStatus" class="form-control form-control-sm">
                    <option value="">Tümü</option>
                    <option value="pending">Not Bekleyenler (Değerlendirilmedi)</option>
                    <option value="graded">Notlandırılmış Teslimler</option>
                </select>
            </div>

            <div class="col-md-3 mb-3 mb-md-0">
                <label class="small font-weight-bold text-gray-700">Sıralama</label>
                <select id="sortDropdown" class="form-control form-control-sm">
                    <option value="date_desc">En Yeni Teslimler (Önce)</option>
                    <option value="date_asc">En Eski Teslimler (Önce)</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="small font-weight-bold text-gray-700">Hızlı Arama</label>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Öğrenci veya ödev adı...">
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4 fade-in">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" width="100%" cellspacing="0">
                <thead class="thead-dark">
                    <tr>
                        @if (role == "Teacher" || role == "Admin")
                        {
                            <th>Öğrenci Adı</th>
                        }
                        <th>Ders ve Ödev Bilgisi</th>
                        <th class="text-center">Dosya</th>
                        <th>Öğrenci Notu (Açıklama)</th>
                        <th>Teslim Tarihi</th>
                        <th class="text-center">Durum / Puan</th>
                        <th class="text-center">İşlem</th>
                    </tr>
                </thead>
                <tbody id="submissionTableBody">
                    <tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-spinner fa-spin fa-2x mb-3"></i><br>Bütün teslimler yükleniyor...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center p-3 border-top bg-light">
            <div id="pageInfo" class="small font-weight-bold text-muted"></div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0" id="paginationContainer"></ul>
            </nav>
        </div>
    </div>
</div>

@* Öğrenci Ödev Yükleme Modalı *@
@if (role == "Student")
{
    <div class="modal fade" id="uploadModal" data-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-file-upload mr-2"></i>Ödev Yükle</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <form id="uploadForm" enctype="multipart/form-data">
                        <div class="form-group">
                            <label class="font-weight-bold text-dark">Hangi Ödevi Teslim Ediyorsunuz?</label>
                            <select id="uploadAssignmentId" class="form-control font-weight-bold" required>
                                <option value="">Ödevler Yükleniyor...</option>
                            </select>
                        </div>
                        <div class="form-group mt-3">
                            <label class="font-weight-bold text-dark">Dosya Seçin</label>
                            <input type="file" id="uploadFile" class="form-control-file p-2 border rounded bg-white" required>
                        </div>
                        <div class="form-group mt-3">
                            <label class="font-weight-bold text-dark">Açıklama / Öğretmene Not (Opsiyonel)</label>
                            <textarea id="uploadNote" class="form-control" rows="2" placeholder="Varsa iletmek istediğiniz notlar..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success btn-block font-weight-bold btn-lg mt-4 shadow-sm" id="btnUploadSubmit">
                            <i class="fas fa-paper-plane mr-2"></i> Yükle ve Teslim Et
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@* Notlandırma Modalı (Öğretmen/Admin İçin) *@
@if (role == "Teacher" || role == "Admin")
{
    <div class="modal fade" id="gradeModal" data-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark border-0">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-star mr-2"></i>Ödevi Değerlendir</h5>
                    <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body bg-light p-4">
                    <form id="gradeForm">
                        <input type="hidden" id="gradeSubmissionId">
                        <div class="form-group">
                            <label class="font-weight-bold text-dark">Verilecek Not (0-100)</label>
                            <input type="number" id="gradeValue" class="form-control form-control-lg text-center font-weight-bold" required min="0" max="100" placeholder="Örn: 85">
                        </div>
                        <div class="form-group mt-3">
                            <label class="font-weight-bold text-dark">Geri Bildirim (Opsiyonel)</label>
                            <textarea id="gradeFeedback" class="form-control" rows="3" placeholder="Öğrenciye iletilecek değerlendirme notunu buraya yazabilirsiniz..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-warning btn-block font-weight-bold btn-lg mt-4 shadow-sm" id="btnGradeSubmit">Puanı Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/locale/tr.min.js"></script>

    <script>
        const API_BASE = "https://localhost:7113/api";
        const USER_ROLE = "@role";

        let currentPage = 1;
        const pageSize = 50;
        let globalSubmissions = [];

        $(document).ready(function () {
            moment.locale('tr');

            loadFilterCourses();
            loadSubmissions(1);

            $("#searchInput").on("keyup", applyFiltersAndRender);
            $("#sortDropdown, #filterCourse, #filterStatus").on("change", applyFiltersAndRender);

            if (USER_ROLE === "Teacher" || USER_ROLE === "Admin") {
                handleGradeForm();
            }

            // Öğrenci Yönlendirme ve Yükleme İşlemleri
            if (USER_ROLE === "Student") {
                const urlParams = new URLSearchParams(window.location.search);
                const targetAssignmentId = urlParams.get('assignmentId');

                if (targetAssignmentId) {
                    loadAssignmentsForUpload(targetAssignmentId);
                    $("#uploadModal").modal("show");
                }

                $("#btnOpenUploadModal").click(function() {
                    loadAssignmentsForUpload();
                    $("#uploadModal").modal("show");
                });

                handleUploadForm();
            }
        });

        // PreSelectId parametresi ile otomatik ödev seçimi
        function loadAssignmentsForUpload(preSelectId = null) {
            $.ajax({
                url: `${API_BASE}/Assignments/for-upload`,
                method: "GET",
                success: function(res) {
                    let html = '<option value="">Lütfen listeden seçiniz...</option>';
                    const data = res.data || res;
                    data.forEach(a => {
                        html += `<option value="${a.id}">${a.courseName} - ${a.title}</option>`;
                    });
                    $("#uploadAssignmentId").html(html);

                    if(preSelectId) {
                        $("#uploadAssignmentId").val(preSelectId);
                    }
                },
                error: function() {
                    $("#uploadAssignmentId").html('<option value="">Ödevler yüklenirken hata oluştu!</option>');
                }
            });
        }

        // Dosya Posta İşlemi
        function handleUploadForm() {
            $("#uploadForm").on("submit", function (e) {
                e.preventDefault();
                let fileInput = $("#uploadFile")[0].files[0];
                let assignmentId = $("#uploadAssignmentId").val();
                let studentNote = $("#uploadNote").val();

                if (!fileInput || !assignmentId) return;

                let formData = new FormData();
                formData.append("AssignmentId", assignmentId);
                formData.append("File", fileInput);
                if (studentNote) formData.append("StudentNote", studentNote);

                let btn = $("#btnUploadSubmit");
                btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Yükleniyor...');

                $.ajax({
                    url: `${API_BASE}/Submissions`,
                    method: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function () {
                        $("#uploadModal").modal("hide");
                        Swal.fire('Başarılı', 'Ödeviniz başarıyla teslim edildi!', 'success');

                        window.history.replaceState(null, null, window.location.pathname);

                        loadSubmissions(1);
                        $("#uploadForm")[0].reset();
                    },
                    error: function (err) {
                        let msg = "Yükleme sırasında hata oluştu.";
                        if (err.responseJSON && err.responseJSON.message) msg = err.responseJSON.message;
                        Swal.fire('Hata', msg, 'error');
                    },
                    complete: function () {
                        btn.prop("disabled", false).html('<i class="fas fa-paper-plane mr-2"></i> Yükle ve Teslim Et');
                    }
                });
            });
        }

        // Filtre için ders listesini doldurur
        function loadFilterCourses() {
            $.ajax({
                url: `${API_BASE}/Courses?pageNumber=1&pageSize=100`,
                method: "GET",
                success: function (res) {
                    const courses = res.data || res;
                    courses.forEach(c => {
                        $("#filterCourse").append(`<option value="${c.name}">${c.name}</option>`);
                    });
                }
            });
        }

        function loadSubmissions(page) {
            currentPage = page;

            let endpoint = USER_ROLE === "Student"
                ? `${API_BASE}/Submissions/student?pageNumber=${page}&pageSize=${pageSize}`
                : `${API_BASE}/Submissions/all?pageNumber=${page}&pageSize=${pageSize}`;

            $.ajax({
                url: endpoint,
                method: "GET",
                beforeSend: function () {
                    $("#submissionTableBody").css("opacity", "0.5");
                },
                success: function (res) {
                    globalSubmissions = res.data || res || [];
                    applyFiltersAndRender();
                    renderPagination(res.totalCount || 0, res.pageNumber || 1, res.totalPages || 1);
                },
                error: function () {
                    $("#submissionTableBody").html('<tr><td colspan="7" class="text-center text-danger py-4 font-weight-bold">Veriler çekilirken bir hata oluştu. Lütfen sayfayı yenileyin.</td></tr>');
                },
                complete: function() {
                    $("#submissionTableBody").css("opacity", "1");
                }
            });
        }

        function applyFiltersAndRender() {
            let filtered = [...globalSubmissions];

            const selectedCourse = $("#filterCourse").val();
            if (selectedCourse) {
                filtered = filtered.filter(s => s.courseName === selectedCourse);
            }

            const selectedStatus = $("#filterStatus").val();
            if (selectedStatus === "pending") {
                filtered = filtered.filter(s => s.grade === null || s.grade === undefined);
            } else if (selectedStatus === "graded") {
                filtered = filtered.filter(s => s.grade !== null && s.grade !== undefined);
            }

            const searchText = $("#searchInput").val().toLowerCase();
            if (searchText) {
                filtered = filtered.filter(s =>
                    (s.studentFullName && s.studentFullName.toLowerCase().includes(searchText)) ||
                    (s.assignmentTitle && s.assignmentTitle.toLowerCase().includes(searchText)) ||
                    (s.courseName && s.courseName.toLowerCase().includes(searchText))
                );
            }

            const sortBy = $("#sortDropdown").val();
            if (sortBy === "date_desc") filtered.sort((a, b) => new Date(b.submissionDate || b.submittedAt) - new Date(a.submissionDate || a.submittedAt));
            else if (sortBy === "date_asc") filtered.sort((a, b) => new Date(a.submissionDate || a.submittedAt) - new Date(b.submissionDate || b.submittedAt));

            renderTable(filtered);
        }

        function renderTable(data) {
            if (data.length === 0) {
                $("#submissionTableBody").html('<tr><td colspan="7" class="text-center text-muted py-5"><i class="fas fa-search fa-2x mb-3 opacity-50"></i><br>Seçilen filtrelere uygun teslim bulunamadı.</td></tr>');
                return;
            }

            let html = "";
            data.forEach(item => {
                const dateText = moment.utc(item.submissionDate || item.submittedAt).local().format('DD.MM.YYYY HH:mm');
                const fileLink = item.filePath
                    ? `<a href="https://localhost:7113/${item.filePath}" target="_blank" class="btn btn-sm btn-outline-info shadow-sm"><i class="fas fa-download mr-1"></i>İndir</a>`
                    : '-';

                let gradeHtml = "";
                if (item.grade !== null && item.grade !== undefined) {
                    gradeHtml = `<span class="badge badge-success px-3 py-2 shadow-sm" style="font-size: 0.9rem;">Not: ${item.grade}</span>`;
                } else {
                    gradeHtml = `<span class="badge badge-warning text-dark px-3 py-2 shadow-sm" style="font-size: 0.9rem;">Not Bekliyor</span>`;
                }

                html += `<tr>`;
                if (USER_ROLE === "Teacher" || USER_ROLE === "Admin") {
                    html += `<td><strong class="text-dark">${item.studentFullName || 'Bilinmiyor'}</strong></td>`;
                }

                html += `
                    <td>
                        <div class="small text-primary font-weight-bold mb-1"><i class="fas fa-book mr-1"></i>${item.courseName || 'Kurs Bilgisi Yok'}</div>
                        <div class="text-dark">${item.assignmentTitle || 'Ödev Başlığı Yok'}</div>
                    </td>
                    <td class="text-center">${fileLink}</td>
                    <td class="text-muted small">${item.studentNote || item.feedback || '-'}</td>
                    <td>${dateText}</td>
                    <td class="text-center">${gradeHtml}</td>
                    <td class="text-center">${renderActions(item)}</td>
                </tr>`;
            });

            $("#submissionTableBody").html(html);
        }

        function renderActions(item) {
            if (USER_ROLE === "Teacher" || USER_ROLE === "Admin") {
                return `<button class="btn btn-sm btn-warning font-weight-bold shadow-sm" onclick="openGradeModal(${item.id})"><i class="fas fa-star mr-1"></i>Puan Ver</button>`;
            }
            return `<span class="text-muted small"><i class="fas fa-check text-success mr-1"></i>Teslim Edildi</span>`;
        }

        function renderPagination(totalCount, current, totalPages) {
            if (totalPages <= 1) {
                $("#paginationContainer, #pageInfo").empty();
                return;
            }
            let html = `<li class="page-item ${current === 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadSubmissions(${current - 1})">Önceki</a></li>`;
            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${i === current ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadSubmissions(${i})">${i}</a></li>`;
            }
            html += `<li class="page-item ${current === totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="loadSubmissions(${current + 1})">Sonraki</a></li>`;
            $("#paginationContainer").html(html);

            const startItem = (current - 1) * pageSize + 1;
            const endItem = Math.min(current * pageSize, totalCount);
            $("#pageInfo").text(`Toplam ${totalCount} teslimattan ${startItem}-${endItem} arası gösteriliyor.`);
        }

        function handleGradeForm() {
            $("#gradeForm").on("submit", function (e) {
                e.preventDefault();
                const subId = $("#gradeSubmissionId").val();
                const data = {
                    grade: parseInt($("#gradeValue").val()),
                    feedback: $("#gradeFeedback").val()
                };

                const btn = $("#btnGradeSubmit");
                btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Kaydediliyor...');

                $.ajax({
                    url: `${API_BASE}/Submissions/${subId}/grade`,
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function () {
                        $("#gradeModal").modal("hide");
                        Swal.fire('Başarılı!', 'Öğrencinin notu başarıyla sisteme işlendi.', 'success');
                        loadSubmissions(currentPage);
                    },
                    error: function(err) {
                        let msg = "Not kaydedilirken hata oluştu.";
                        if(err.responseJSON && err.responseJSON.message) msg = err.responseJSON.message;
                        Swal.fire('Hata', msg, 'error');
                    },
                    complete: function () {
                        btn.prop("disabled", false).text("Puanı Kaydet");
                    }
                });
            });
        }

        function openGradeModal(id) {
            const sub = globalSubmissions.find(s => s.id === id);
            if (sub) {
                $("#gradeSubmissionId").val(sub.id);
                $("#gradeValue").val(sub.grade || '');
                $("#gradeFeedback").val(sub.feedback || '');
                $("#gradeModal").modal("show");
            }
        }
    </script>
}