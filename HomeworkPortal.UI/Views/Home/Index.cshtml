@{
    ViewData["Title"] = "Geleceğin Eğitim Platformu";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="main-banner" id="top">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="owl-carousel owl-banner">
                    <div class="item item-1">
                        <div class="header-text">
                            <span class="category">Öğrenim Yönetim Sistemi</span>
                            <h2>Modern ve Hızlı Eğitim Platformu</h2>
                            <p>Homework Portal ile kurslarınızı, ödevlerinizi ve öğrencilerin ilerlemelerini gerçek zamanlı olarak takip edin. Geleceğin sınıfı artık parmaklarınızın ucunda.</p>
                            <div class="buttons">
                                <div class="main-button"><a href="/Auth/Login">Sisteme Giriş Yap</a></div>
                                <div class="icon-button"><a href="#courses"><i class="fa fa-play"></i> Kursları Keşfet</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="services section" id="features">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-6">
                <div class="service-item">
                    <div class="icon"><img src="~/scholar/assets/images/service-01.png" alt="online degrees"></div>
                    <div class="main-content">
                        <h4>Sıfır Kesinti</h4>
                        <p>Gerçek zamanlı SignalR altyapısı ile yeni ödevler ve notlandırmalar anında ekranınızda belirir.</p>
                        <div class="main-button"><a href="/Auth/Register">Kayıt Ol</a></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="service-item">
                    <div class="icon"><img src="~/scholar/assets/images/service-02.png" alt="short courses"></div>
                    <div class="main-content">
                        <h4>Dinamik Takip</h4>
                        <p>Ödev teslimlerinizi ve derslerdeki genel ilerlemelerinizi interaktif grafiklerle izleyin.</p>
                        <div class="main-button"><a href="/Auth/Register">Sistemi İncele</a></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="service-item">
                    <div class="icon"><img src="~/scholar/assets/images/service-03.png" alt="web experts"></div>
                    <div class="main-content">
                        <h4>Oyunlaştırma</h4>
                        <p>Başarı rozetleri kazanın, ödevleri zamanında teslim ederek sistemde efsane statüsüne ulaşın.</p>
                        <div class="main-button"><a href="/Auth/Register">Hemen Başla</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="section courses" id="courses">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="section-heading">
                    <h6>Sistemdeki Kurslar</h6>
                    <h2>Öğrenmeye Hemen Başlayın</h2>
                </div>
            </div>
        </div>
        <div class="row event_box" id="landingCoursesContainer">
            <div class="col-12 text-center py-5">
                <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                <p class="mt-3 font-weight-bold">Kurslar Yükleniyor...</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $.get("https://localhost:7113/api/Courses?pageNumber=1&pageSize=6", function(res) {
                let courses = res.data || res;
                let html = "";

                if(courses.length === 0){
                    $("#landingCoursesContainer").html('<div class="col-12 text-center"><p class="text-muted">Henüz açılmış bir kurs bulunmuyor.</p></div>');
                    return;
                }

                courses.forEach((c, index) => {

                    let imgNum = (index % 6) + 1;
                    let imgSrc = `/scholar/assets/images/course-0${imgNum}.jpg`;

                    let teacherName = c.teacherFullName || 'Öğretmen';
                    let avatar = `https://ui-avatars.com/api/?name=${encodeURIComponent(teacherName)}&background=random&color=fff&rounded=true&bold=true`;

                    html += `
                    <div class="col-lg-4 col-md-6 align-self-center mb-30 event_outer">
                        <div class="events_item shadow-sm" style="border-radius: 20px; overflow: hidden; background: #fff;">
                            <div class="thumb position-relative">
                                <a href="/Auth/Login"><img src="${imgSrc}" alt="${c.name}" style="width: 100%; height:220px; object-fit:cover;"></a>
                                <span class="category position-absolute" style="top: 15px; left: 15px; background: rgba(10, 40, 150, 0.9); color: white; padding: 5px 15px; border-radius: 15px; font-size: 12px; font-weight: bold;">${c.categoryName || 'Genel'}</span>
                            </div>
                            <div class="down-content p-4" style="text-align:left;">
                                <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                    <img src="${avatar}" style="width:45px; height:45px; margin-right:15px; border-radius:50%; box-shadow: 0 2px 5px rgba(0,0,0,0.1);" alt="${teacherName}">
                                    <span class="author font-weight-bold text-dark">${teacherName}</span>
                                </div>
                                <h4 class="mb-2 text-dark font-weight-bold" style="font-size: 1.2rem;">${c.name}</h4>
                                <p class="text-muted mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.9rem; line-height: 1.5;">${c.description}</p>
                                <a href="/Auth/Login" class="btn btn-primary btn-block text-white font-weight-bold py-2" style="border-radius:25px; background-color: #0a2896;">Kursa Kayıt Ol <i class="fas fa-arrow-right ml-2"></i></a>
                            </div>
                        </div>
                    </div>`;
                });

                $("#landingCoursesContainer").html(html);
            }).fail(function() {
                $("#landingCoursesContainer").html('<div class="col-12 text-center text-danger"><p>Kurslar yüklenirken sunucu ile bağlantı kurulamadı.</p></div>');
            });
        });
    </script>
}