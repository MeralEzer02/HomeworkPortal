@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>HW Portal - Sisteme Giriş</title>

    <link href="~/scholar/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #7a6ad8;
            font-family: 'Poppins', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }

        .login-card {
            background: #fff;
            padding: 50px 40px;
            border-radius: 25px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 450px;
            text-align: center;
        }

            .login-card h2 {
                color: #7a6ad8;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .login-card p {
                color: #777;
                margin-bottom: 30px;
                font-size: 14px;
            }

        .form-control {
            border-radius: 25px;
            height: 50px;
            margin-bottom: 20px;
            padding-left: 20px;
            background-color: #f4f7fb;
            border: none;
        }

            .form-control:focus {
                box-shadow: none;
                border: 1px solid #7a6ad8;
                background-color: #fff;
            }

        .btn-primary {
            border-radius: 25px;
            height: 50px;
            background-color: #7a6ad8;
            border: none;
            font-weight: bold;
            width: 100%;
            font-size: 16px;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                background-color: #5b4ec4;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(122, 106, 216, 0.4);
            }
    </style>
</head>
<body>

    <div class="login-card">
        <h2>HW PORTAL</h2>
        <p>Öğrenim Yönetim Sistemine Hoş Geldiniz</p>

        <form id="loginForm">
            <input type="email" class="form-control" id="email" placeholder="E-Posta Adresi" required>
            <input type="password" class="form-control" id="password" placeholder="Şifre" required>
            <button type="submit" class="btn btn-primary" id="btnLogin">Sisteme Giriş Yap</button>
        </form>

        <div class="mt-4">
            <a href="/Auth/Register" style="color: #7a6ad8; font-size: 14px; text-decoration: none; font-weight: 500;">Hesabınız yok mu? Hemen Kayıt Olun</a>
        </div>
    </div>

    <script src="~/scholar/vendor/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $("#loginForm").on("submit", function (e) {
                e.preventDefault();
                const email = $("#email").val();
                const password = $("#password").val();

                $.ajax({
                    url: "https://localhost:7113/api/Auth/login",
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ email: email, password: password }),
                    beforeSend: function() { $("#btnLogin").prop("disabled", true).text("Giriş Yapılıyor..."); },
                    success: function (res) {
                        $.post("/Auth/SetSession", { token: res.token }, function () {
                            window.location.href = "/Home/Dashboard";
                        });
                    },
                    error: function (err) {
                        let msg = err.responseJSON?.message || "Giriş başarısız!";
                        Swal.fire({ icon: 'error', title: 'Hata', text: msg, confirmButtonColor: '#7a6ad8' });
                        $("#btnLogin").prop("disabled", false).text("Sisteme Giriş Yap");
                    }
                });
            });
        });
    </script>
</body>
</html>