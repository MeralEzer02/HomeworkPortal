@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using System.Text
@inject IHttpContextAccessor HttpContextAccessor
@{
    var token = HttpContextAccessor.HttpContext?.Session.GetString("Token");
    var userEmail = "Öğrenci";
    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value?.ToLower() ?? "";

    if (!string.IsNullOrEmpty(token))
    {
        try
        {
            var payload = token.Split('.')[1].Replace('-', '+').Replace('_', '/').PadRight(token.Split('.')[1].Length + (4 - token.Split('.')[1].Length % 4) % 4, '=');
            var parsed = JsonSerializer.Deserialize<JsonElement>(Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            if (parsed.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress", out var emailProp)) userEmail = emailProp.GetString() ?? "Öğrenci";
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>HW Portal - Öğrenci Merkezi</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        body {
            background-color: #f4f7fb;
            font-family: 'Poppins', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .student-navbar {
            background-color: #7a6ad8;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            padding: 15px 0;
            transition: background-color 0.3s ease;
        }

            .student-navbar .navbar-brand {
                font-size: 24px;
                font-weight: 800;
                letter-spacing: 1px;
                color: #fff !important;
            }

            .student-navbar .nav-link {
                color: rgba(255,255,255,0.8) !important;
                font-weight: 500;
                margin: 0 10px;
                transition: 0.3s;
            }

                .student-navbar .nav-link:hover, .student-navbar .nav-link.active {
                    color: #fff !important;
                    text-decoration: underline;
                    text-decoration-thickness: 2px;
                    text-underline-offset: 5px;
                }

        .btn-logout {
            background-color: #fff;
            color: #7a6ad8 !important;
            border-radius: 20px;
            font-weight: 600;
            padding: 8px 20px;
            transition: 0.3s;
        }

            .btn-logout:hover {
                background-color: #ffcccc;
                color: #d32f2f !important;
            }

        .student-content {
            padding-top: 40px;
            min-height: 80vh;
            padding-bottom: 50px;
        }

        .student-card {
            background: #fff;
            border-radius: 15px;
            border: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s, background-color 0.3s, color 0.3s;
            overflow: hidden;
        }

            .student-card:hover {
                transform: translateY(-5px);
            }

        .card-header-purple {
            background-color: #7a6ad8;
            color: #fff;
            font-weight: 600;
            border-radius: 15px 15px 0 0 !important;
            padding: 15px 20px;
        }

        .fade-in {
            animation: fadeIn 0.5s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* DARK MODE (GECE MODU) KODLARI */
        body.dark-mode {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }

            body.dark-mode .student-navbar {
                background-color: #1f1f1f !important;
                box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            }

                body.dark-mode .student-navbar .navbar-brand i {
                    color: #e0e0e0 !important;
                }

            body.dark-mode h1, body.dark-mode h2, body.dark-mode h3,
            body.dark-mode h4, body.dark-mode h5, body.dark-mode h6,
            body.dark-mode .student-card *, body.dark-mode .student-card p {
                color: #f8f9fc !important;
            }

            body.dark-mode strong {
                color: #fff !important;
            }

            body.dark-mode .student-card,
            body.dark-mode .modal-content {
                background-color: #26262a !important;
                color: #e0e0e0 !important;
                border-color: #3a3a40 !important;
            }

            body.dark-mode .bg-white,
            body.dark-mode .bg-light,
            body.dark-mode .card,
            body.dark-mode .card-body,
            body.dark-mode .modal-body,
            body.dark-mode .modal-header,
            body.dark-mode .modal-footer {
                background-color: #26262a !important;
                color: #e0e0e0 !important;
                border-color: #3a3a40 !important;
            }

            body.dark-mode .nav-tabs .nav-link {
                color: #a0a0a0 !important;
                border-color: transparent !important;
            }

                body.dark-mode .nav-tabs .nav-link.active {
                    background-color: #26262a !important;
                    color: #fff !important;
                    border-color: #3a3a40 #3a3a40 transparent #3a3a40 !important;
                }

            body.dark-mode .table {
                color: #e0e0e0 !important;
                background-color: transparent !important;
            }

                body.dark-mode .table td, body.dark-mode .table th {
                    border-top: 1px solid #3a3a40 !important;
                }

            body.dark-mode .table-bordered,
            body.dark-mode .table-bordered td,
            body.dark-mode .table-bordered th {
                border: 1px solid #3a3a40 !important;
            }

            body.dark-mode .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(255,255,255,0.03) !important;
            }

            body.dark-mode .text-danger, body.dark-mode a.text-danger {
                color: #ea918c !important;
            }

            body.dark-mode .text-muted {
                color: #a0a0a0 !important;
            }

            body.dark-mode .card-header-purple {
                background-color: #3a3b45 !important;
            }

            body.dark-mode .form-control,
            body.dark-mode .form-control-file {
                background-color: #333 !important;
                border-color: #555 !important;
                color: #fff !important;
            }

            body.dark-mode .btn-logout {
                background-color: #333;
                color: #fff !important;
                border: 1px solid #555;
            }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg student-navbar">
        <div class="container">
            <a class="navbar-brand" href="/Home/Dashboard"><i class="fas fa-graduation-cap mr-2"></i>HW PORTAL</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#studentNav">
                <i class="fas fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="studentNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link @(currentPath.Contains("/dashboard") || currentPath == "/" ? "active" : "")" href="/Home/Dashboard">Ana Ekran</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPath.Contains("/courses") ? "active" : "")" href="/Courses">Kurslarım</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPath.Contains("/assignments") ? "active" : "")" href="/Assignments">Ödevlerim</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPath.Contains("/submissions") ? "active" : "")" href="/Submissions">Notlarım</a></li>

                    <li class="nav-item mx-lg-3 my-2 my-lg-0">
                        <a class="nav-link" href="#" id="darkModeToggle" title="Gece/Gündüz Modu" style="font-size: 1.2rem;">
                            <i class="fas fa-moon" id="darkModeIcon"></i>
                        </a>
                    </li>

                    <li class="nav-item ml-lg-2"><a class="btn btn-logout" href="/Auth/Logout"><i class="fas fa-sign-out-alt mr-1"></i> Çıkış Yap</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="student-content container fade-in">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var jwtToken = "@Html.Raw(token)";
        $.ajaxPrefilter(function (options, originalOptions, jqXHR) {
            if (jwtToken && options.url.includes("7113")) { jqXHR.setRequestHeader('Authorization', 'Bearer ' + jwtToken); }
        });
        $(document).ajaxError(function (event, xhr, settings) {
            if (settings.url.includes("7113") && xhr.status === 401) { window.location.href = "/Auth/Login"; }
        });

        // GECE MODU (DARK MODE) JAVASCRIPT MOTORU
        $(document).ready(function () {
            const currentTheme = localStorage.getItem('theme');

            if (currentTheme === 'dark') {
                $('body').addClass('dark-mode');
                $('#darkModeIcon').removeClass('fa-moon').addClass('fa-sun text-warning');
            }

            $('#darkModeToggle').click(function (e) {
                e.preventDefault();
                $('body').toggleClass('dark-mode');

                let theme = 'light';
                if ($('body').hasClass('dark-mode')) {
                    theme = 'dark';
                    $('#darkModeIcon').removeClass('fa-moon').addClass('fa-sun text-warning');
                } else {
                    $('#darkModeIcon').removeClass('fa-sun text-warning').addClass('fa-moon');
                }

                localStorage.setItem('theme', theme);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>