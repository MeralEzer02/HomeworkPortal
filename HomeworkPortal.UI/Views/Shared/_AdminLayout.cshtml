@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using System.Text
@inject IHttpContextAccessor HttpContextAccessor

@{
    var token = HttpContextAccessor.HttpContext?.Session.GetString("Token");
    var userRole = "Admin";
    var userEmail = "Kullanıcı";
    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value?.ToLower() ?? "";

    if (!string.IsNullOrEmpty(token))
    {
        try
        {
            var payload = token.Split('.')[1].Replace('-', '+').Replace('_', '/').PadRight(token.Split('.')[1].Length + (4 - token.Split('.')[1].Length % 4) % 4, '=');
            var parsed = JsonSerializer.Deserialize<JsonElement>(Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            if (parsed.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress", out var emailProp)) userEmail = emailProp.GetString() ?? "Admin";
            else if (parsed.TryGetProperty("email", out emailProp)) userEmail = emailProp.GetString() ?? "Admin";
        }
        catch { }
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>HW Portal - Yönetici Paneli</title>
    <link href="~/Admin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/Admin/css/sb-admin-2.min.css" rel="stylesheet">
    <style>
        .toast-container {
            z-index: 1055 !important;
        }

        ul.navbar-nav.bg-gradient-primary {
            background-color: #0a2896 !important;
            background-image: linear-gradient(180deg, #0a2896 10%, #051650 100%) !important;
        }

        .text-primary, .btn-link {
            color: #0a2896 !important;
        }

        .btn-primary {
            background-color: #0a2896 !important;
            border-color: #0a2896 !important;
        }

            .btn-primary:hover {
                background-color: #081e70 !important;
                border-color: #081e70 !important;
            }

        .card.border-left-primary {
            border-left-color: #0a2896 !important;
        }

        body.dark-mode {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }

            body.dark-mode #wrapper #content-wrapper {
                background-color: #1a1a1c !important;
            }

            body.dark-mode .bg-white, body.dark-mode .bg-light, body.dark-mode .card, body.dark-mode .card-header, body.dark-mode .navbar, body.dark-mode .modal-content, body.dark-mode .dropdown-menu {
                background-color: #26262a !important;
                border-color: #3a3a40 !important;
                color: #e0e0e0 !important;
            }

            body.dark-mode h1, body.dark-mode h2, body.dark-mode h3, body.dark-mode h4, body.dark-mode .text-gray-800, body.dark-mode .text-dark {
                color: #f8f9fc !important;
            }

            body.dark-mode .text-muted {
                color: #a0a0a0 !important;
            }

            body.dark-mode .table td, body.dark-mode .table th {
                background-color: #26262a !important;
                color: #e0e0e0 !important;
                border-color: #444 !important;
            }

            body.dark-mode .form-control {
                background-color: #333 !important;
                border-color: #555 !important;
                color: #fff !important;
            }

            body.dark-mode .dropdown-item:hover {
                background-color: #3a3b45 !important;
                color: #fff !important;
            }

        .fade-in {
            animation: fadeIn 0.4s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body id="page-top">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/Home/Dashboard"><div class="sidebar-brand-icon"><i class="fas fa-user-shield"></i></div><div class="sidebar-brand-text mx-3">HW PORTAL</div></a>
            <hr class="sidebar-divider my-0">
            <li class="nav-item @(currentPath == "/" || currentPath.Contains("/dashboard") ? "active" : "")"><a class="nav-link" href="/Home/Dashboard"><i class="fas fa-fw fa-tachometer-alt"></i><span>Ana Ekran</span></a></li>
            <hr class="sidebar-divider">
            <div class="sidebar-heading">Sistem Yönetimi</div>
            <li class="nav-item @(currentPath.Contains("/users") ? "active" : "")"><a class="nav-link" href="/Users"><i class="fas fa-fw fa-users"></i><span>Kullanıcılar</span></a></li>
            <li class="nav-item @(currentPath.Contains("/actionlogs") ? "active" : "")"><a class="nav-link" href="/ActionLogs"><i class="fas fa-fw fa-history"></i><span>İşlem Logları</span></a></li>
            <hr class="sidebar-divider">
            <div class="sidebar-heading">Eğitim Yönetimi</div>
            <li class="nav-item @(currentPath.Contains("/courses") ? "active" : "")"><a class="nav-link" href="/Courses"><i class="fas fa-fw fa-book"></i><span>Tüm Kurslar</span></a></li>
            <li class="nav-item @(currentPath.Contains("/assignments") ? "active" : "")"><a class="nav-link" href="/Assignments"><i class="fas fa-fw fa-tasks"></i><span>Sistemdeki Ödevler</span></a></li>
            <li class="nav-item @(currentPath.Contains("/submissions") ? "active" : "")"><a class="nav-link" href="/Submissions"><i class="fas fa-fw fa-check-square"></i><span>Tüm Teslimler</span></a></li>
            <hr class="sidebar-divider d-none d-md-block">
            <div class="text-center d-none d-md-inline"><button class="rounded-circle border-0" id="sidebarToggle"></button></div>
        </ul>

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3"><i class="fa fa-bars"></i></button>
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item dropdown no-arrow mx-1">
                            <a class="nav-link" href="#" id="darkModeToggle" role="button" title="Gece/Gündüz Modu"><i class="fas fa-moon fa-lg text-gray-600" id="darkModeIcon"></i></a>
                        </li>
                        <li class="nav-item dropdown no-arrow mx-1">
                            <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button" data-toggle="dropdown"><i class="fas fa-bell fa-fw text-gray-600"></i><span class="badge badge-danger badge-counter" id="notificationBadge" style="display:none;">0</span></a>
                            <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in"><h6 class="dropdown-header bg-primary border-primary">Bildirim Merkezi</h6><div id="notificationItemsContainer" style="max-height: 300px; overflow-y: auto;"><a class="dropdown-item text-center small text-gray-500 py-3">Henüz yeni bir bildirim yok.</a></div></div>
                        </li>
                        <div class="topbar-divider d-none d-sm-block"></div>
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown"><span class="mr-2 d-none d-lg-inline text-gray-600 small"><strong>@userEmail.Split('@')[0]</strong><br><small class="text-primary">@userRole</small></span><img class="img-profile rounded-circle" src="~/Admin/img/undraw_profile.svg"></a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"><a class="dropdown-item" href="/Profile"><i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i> Profilim</a><div class="dropdown-divider"></div><a class="dropdown-item text-danger" href="/Auth/Logout"><i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-danger"></i> Çıkış Yap</a></div>
                        </li>
                    </ul>
                </nav>
                <div class="container-fluid">@RenderBody()</div>
            </div>
            <footer class="sticky-footer bg-white"><div class="container my-auto"><div class="copyright text-center my-auto"><span>Copyright &copy; HomeworkPortal 2026</span></div></div></footer>
        </div>
    </div>
    <a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>

    <script src="~/Admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/Admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Admin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Admin/js/sb-admin-2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>

    <script>
        var jwtToken = "@Html.Raw(token)";
        $.ajaxPrefilter(function (options, originalOptions, jqXHR) { if (jwtToken && options.url.includes("7113")) { jqXHR.setRequestHeader('Authorization', 'Bearer ' + jwtToken); } });
        $(document).ajaxError(function (event, xhr, settings) {
            if (settings.url.includes("7113") && xhr.status === 401) { window.location.href = "/Auth/Login"; }
        });

        $(document).ready(function () {
            if (localStorage.getItem('theme') === 'dark') { $('body').addClass('dark-mode'); $('#darkModeIcon').removeClass('fa-moon text-gray-600').addClass('fa-sun text-warning'); }
            $('#darkModeToggle').click(function (e) {
                e.preventDefault(); $('body').toggleClass('dark-mode');
                if ($('body').hasClass('dark-mode')) { localStorage.setItem('theme', 'dark'); $('#darkModeIcon').removeClass('fa-moon text-gray-600').addClass('fa-sun text-warning'); }
                else { localStorage.setItem('theme', 'light'); $('#darkModeIcon').removeClass('fa-sun text-warning').addClass('fa-moon text-gray-600'); }
            });

            $("#alertsDropdown").click(function(e){
                e.preventDefault(); $("#notificationBadge").hide();
                $("#notificationItemsContainer").html(`<a class="dropdown-item d-flex align-items-center" href="#"><div class="mr-3"><div class="icon-circle bg-success"><i class="fas fa-check text-white"></i></div></div><div><div class="small text-gray-500">Bugün</div>Sistem başarıyla güncellendi!</div></a>`);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>