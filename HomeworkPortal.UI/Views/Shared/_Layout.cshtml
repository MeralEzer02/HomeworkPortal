@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using System.Text
@inject IHttpContextAccessor HttpContextAccessor

@{
    var token = HttpContextAccessor.HttpContext?.Session.GetString("Token");
    var userRole = "";
    var userEmail = "Kullanıcı";

    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value?.ToLower() ?? "";

    if (!string.IsNullOrEmpty(token))
    {
        try
        {
            var payload = token.Split('.')[1];
            payload = payload.Replace('-', '+').Replace('_', '/');
            payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');

            var bytes = Convert.FromBase64String(payload);
            var json = Encoding.UTF8.GetString(bytes);
            var parsed = JsonSerializer.Deserialize<JsonElement>(json);

            if (parsed.TryGetProperty("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out var roleProp))
                userRole = roleProp.GetString() ?? "";
            else if (parsed.TryGetProperty("role", out roleProp))
                userRole = roleProp.GetString() ?? "";

            if (parsed.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress", out var emailProp))
                userEmail = emailProp.GetString() ?? "Kullanıcı";
            else if (parsed.TryGetProperty("email", out emailProp))
                userEmail = emailProp.GetString() ?? "Kullanıcı";
        }
        catch { }
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>HomeworkPortal - @ViewData["Title"]</title>

    <link href="~/Admin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/Admin/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .toast-container {
            z-index: 1055 !important;
        }

        /* TEMEL UI GÜNCELLEMELERİ */
        ul.navbar-nav.bg-gradient-primary {
            background-color: #0a2896 !important;
            background-image: linear-gradient(180deg, #0a2896 10%, #051650 100%) !important;
        }

        .text-primary, .btn-link {
            color: #0a2896 !important;
        }

        .btn-primary {
            background-color: #0a2896 !important;
            border-color: #0a2896 !important;
        }

            .btn-primary:hover {
                background-color: #081e70 !important;
                border-color: #081e70 !important;
            }

        .card.border-left-primary {
            border-left-color: #0a2896 !important;
        }

        /* DARK MODE */
        body.dark-mode {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }

            body.dark-mode #wrapper #content-wrapper {
                background-color: #1a1a1c !important;
            }

            body.dark-mode .bg-white, body.dark-mode .bg-light, body.dark-mode .card,
            body.dark-mode .card-header, body.dark-mode .navbar, body.dark-mode .modal-content,
            body.dark-mode .dropdown-menu, body.dark-mode .alert {
                background-color: #26262a !important;
                border-color: #3a3a40 !important;
                color: #e0e0e0 !important;
            }

            body.dark-mode h1, body.dark-mode h2, body.dark-mode h3, body.dark-mode h4, body.dark-mode h5, body.dark-mode h6,
            body.dark-mode .text-gray-800, body.dark-mode .text-gray-900, body.dark-mode .text-dark {
                color: #f8f9fc !important;
            }

            body.dark-mode .text-muted, body.dark-mode .text-gray-600 {
                color: #a0a0a0 !important;
            }

            body.dark-mode .text-primary {
                color: #64b5f6 !important;
            }

            body.dark-mode .text-info {
                color: #4dd0e1 !important;
            }

            body.dark-mode .table td, body.dark-mode .table th {
                background-color: #26262a !important;
                color: #e0e0e0 !important;
                border-color: #444 !important;
            }

            body.dark-mode .table-hover tbody tr:hover td, body.dark-mode .table-hover tbody tr:hover th {
                background-color: #34343a !important;
                color: #fff !important;
            }

            body.dark-mode .table-striped tbody tr:nth-of-type(odd) td, body.dark-mode .table-striped tbody tr:nth-of-type(odd) th {
                background-color: #1a1a1c !important;
            }

            body.dark-mode .table thead.thead-dark th {
                background-color: #111 !important;
                border-color: #222 !important;
                color: #fff !important;
            }

            body.dark-mode .form-control {
                background-color: #333 !important;
                border-color: #555 !important;
                color: #fff !important;
            }

                body.dark-mode .form-control:focus {
                    background-color: #3b3b3b !important;
                    color: #fff !important;
                    border-color: #64b5f6 !important;
                }

                body.dark-mode .form-control[readonly] {
                    background-color: #2a2a2a !important;
                }

            body.dark-mode .dropdown-item {
                color: #e0e0e0 !important;
            }

                body.dark-mode .dropdown-item:hover {
                    background-color: #3a3b45 !important;
                    color: #fff !important;
                }

            body.dark-mode .list-group-item {
                background-color: #26262a !important;
                border-color: #444 !important;
                color: #e0e0e0 !important;
            }

            body.dark-mode a:not(.btn):not(.nav-link), body.dark-mode .btn-link {
                color: #64b5f6 !important;
            }

            body.dark-mode .btn-primary {
                color: #fff !important;
                background-color: #2e59d9 !important;
                border-color: #2e59d9 !important;
            }

            body.dark-mode .swal2-popup {
                background-color: #26262a !important;
                color: #e0e0e0 !important;
            }

            body.dark-mode .swal2-title, body.dark-mode .swal2-html-container {
                color: #e0e0e0 !important;
            }

        .fade-in {
            animation: fadeIn 0.4s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body id="page-top">
    <div id="wrapper">
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/">
                <div class="sidebar-brand-icon rotate-n-15"><i class="fas fa-graduation-cap"></i></div>
                <div class="sidebar-brand-text mx-3">HW Portal</div>
            </a>
            <hr class="sidebar-divider my-0">

            <li class="nav-item @(currentPath == "/" || currentPath.Contains("/home") ? "active" : "")">
                <a class="nav-link" href="/Home/Index">
                    <i class="fas fa-fw fa-tachometer-alt"></i><span>Ana Ekran</span>
                </a>
            </li>

            @if (userRole == "Admin" || userRole == "Teacher")
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Sistem Yönetimi</div>
                <li class="nav-item @(currentPath.Contains("/users") ? "active" : "")">
                    <a class="nav-link" href="/Users">
                        <i class="fas fa-fw fa-users-cog"></i><span>@(userRole == "Teacher" ? "Öğrencilerim" : "Kullanıcılar")</span>
                    </a>
                </li>
                @if (userRole == "Admin")
                {
                    <li class="nav-item @(currentPath.Contains("/actionlogs") ? "active" : "")">
                        <a class="nav-link" href="/ActionLogs">
                            <i class="fas fa-fw fa-user-secret"></i><span>İşlem Logları</span>
                        </a>
                    </li>
                }
            }

            <hr class="sidebar-divider">
            <div class="sidebar-heading">Eğitim Yönetimi</div>

            <li class="nav-item @(currentPath.Contains("/courses") ? "active" : "")">
                <a class="nav-link" href="/Courses">
                    <i class="fas fa-fw fa-book"></i><span>Kurslar</span>
                </a>
            </li>

            @if (userRole == "Teacher" || userRole == "Student" || userRole == "Admin")
            {
                <li class="nav-item @(currentPath.Contains("/assignments") ? "active" : "")">
                    <a class="nav-link" href="/Assignments">
                        <i class="fas fa-fw fa-tasks"></i><span>Ödevler</span>
                    </a>
                </li>
            }

            @if (userRole == "Teacher" || userRole == "Student" || userRole == "Admin")
            {
                <li class="nav-item @(currentPath.Contains("/submissions") ? "active" : "")">
                    <a class="nav-link" href="/Submissions">
                        <i class="fas fa-fw fa-check-square"></i><span>Teslimler</span>
                    </a>
                </li>
            }

            <hr class="sidebar-divider d-none d-md-block">
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item dropdown no-arrow mx-1">
                            <a class="nav-link" href="#" id="darkModeToggle" role="button" title="Gece/Gündüz Modu">
                                <i class="fas fa-moon fa-lg text-gray-600" id="darkModeIcon"></i>
                            </a>
                        </li>

                        <li class="nav-item dropdown no-arrow mx-1">
                            <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-bell fa-fw text-gray-600"></i>
                                <span class="badge badge-danger badge-counter" id="notificationBadge" style="display:none;">0</span>
                            </a>
                            <div class="dropdown-list dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="alertsDropdown">
                                <h6 class="dropdown-header bg-primary border-primary">Bildirim Merkezi</h6>
                                <div id="notificationItemsContainer" style="max-height: 300px; overflow-y: auto;">
                                    <a class="dropdown-item text-center small text-gray-500 py-3">Henüz yeni bir bildirim yok.</a>
                                </div>
                                <a class="dropdown-item text-center small text-gray-500 font-weight-bold" href="/Submissions">Tüm Teslimleri Gör</a>
                            </div>
                        </li>

                        <div class="topbar-divider d-none d-sm-block"></div>

                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">
                                    <strong>@userEmail.Split('@')[0]</strong> <br>
                                    <small class="text-primary">@userRole</small>
                                </span>
                                <img class="img-profile rounded-circle" src="~/Admin/img/undraw_profile.svg">
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="/Profile">
                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i> Profilim
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" href="/Auth/Logout">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-danger"></i> Çıkış Yap
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; HomeworkPortal 2026</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/Admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Admin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Admin/js/sb-admin-2.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>

    <script>
        var jwtToken = "@Html.Raw(token)";

        $.ajaxPrefilter(function (options, originalOptions, jqXHR) {
            if (jwtToken && options.url.includes("7113")) {
                jqXHR.setRequestHeader('Authorization', 'Bearer ' + jwtToken);
            }
        });

        $(document).ajaxError(function (event, xhr, settings) {
            if (settings.url.includes("7113")) {
                let errorMsg = "Sunucu ile iletişim kurulamadı.";

                if (xhr.status === 401) {
                    Swal.fire('Oturum Kapandı', 'Oturum süreniz doldu veya geçersiz.', 'warning').then(() => window.location.href = "/Auth/Login");
                    return;
                } else if (xhr.status === 403) {
                    errorMsg = "Bu işlemi gerçekleştirmek için yetkiniz bulunmamaktadır.";
                } else if (xhr.status === 400) {
                    errorMsg = xhr.responseJSON?.message || xhr.responseJSON?.detail || "Geçersiz istek.";
                } else if (xhr.status === 500) {
                    errorMsg = "Sunucuda beklenmeyen bir hata oluştu.";
                }

                Swal.fire({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 5000, timerProgressBar: true, background: '#e74a3b', color: '#fff', icon: 'error', title: 'Hata (' + xhr.status + ')', text: errorMsg });
            }
        });

        // --- DARK MODE ---
        $(document).ready(function () {
            const currentTheme = localStorage.getItem('theme');
            if (currentTheme === 'dark') {
                $('body').addClass('dark-mode');
                $('#darkModeIcon').removeClass('fa-moon text-gray-600').addClass('fa-sun text-warning');
            }

            $('#darkModeToggle').click(function (e) {
                e.preventDefault();
                $('body').toggleClass('dark-mode');
                let theme = 'light';
                if ($('body').hasClass('dark-mode')) {
                    theme = 'dark';
                    $('#darkModeIcon').removeClass('fa-moon text-gray-600').addClass('fa-sun text-warning');
                } else {
                    $('#darkModeIcon').removeClass('fa-sun text-warning').addClass('fa-moon text-gray-600');
                }
                localStorage.setItem('theme', theme);
            });
        });

        // --- REAL-TIME SİGNALR VE KALICI BİLDİRİMLER ---
        let unreadCount = 0;

        function addNotificationToBell(message, id = 0) {
            unreadCount++;
            $("#notificationBadge").text(unreadCount > 9 ? "9+" : unreadCount).show();

            const time = moment().format('HH:mm');
            const newNotif = `
                <a class="dropdown-item d-flex align-items-center border-bottom fade-in" href="#" onclick="event.stopPropagation(); markAsRead(${id}, this); return false;">
                    <div class="mr-3">
                        <div class="icon-circle bg-primary text-white">
                            <i class="fas fa-info-circle"></i>
                        </div>
                    </div>
                    <div>
                        <div class="small text-gray-500">${time}</div>
                        <span class="font-weight-bold" style="font-size: 0.85rem; white-space: normal;">${message}</span>
                    </div>
                </a>`;

            if($("#notificationItemsContainer .text-center").length > 0) {
                $("#notificationItemsContainer").empty();
            }

            $("#notificationItemsContainer").prepend(newNotif);
        }

        function loadInitialNotifications() {
            $.ajax({
                url: "https://localhost:7113/api/Notifications?pageNumber=1&pageSize=10",
                method: "GET",
                success: function (res) {
                    const notifications = res.data || res;
                    if (notifications && notifications.length > 0) {
                        $("#notificationItemsContainer").empty();
                        let unread = 0;

                        notifications.forEach(n => {
                            if (!n.isRead) unread++;

                            const time = moment.utc(n.created).local().format('DD.MM HH:mm');
                            const bgClass = n.isRead ? "bg-secondary" : "bg-primary";
                            const opacity = n.isRead ? "opacity-50" : "";

                            const newNotif = `
                                <a class="dropdown-item d-flex align-items-center border-bottom fade-in ${opacity}" href="#" onclick="event.stopPropagation(); markAsRead(${n.id}, this); return false;">
                                    <div class="mr-3">
                                        <div class="icon-circle ${bgClass} text-white">
                                            <i class="fas fa-info-circle"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="small text-gray-500">${time}</div>
                                        <span class="font-weight-bold" style="font-size: 0.85rem; white-space: normal;">${n.message}</span>
                                    </div>
                                </a>`;
                            $("#notificationItemsContainer").append(newNotif);
                        });

                        unreadCount = unread;
                        if (unreadCount > 0) {
                            $("#notificationBadge").text(unreadCount > 9 ? "9+" : unreadCount).show();
                        } else {
                            $("#notificationBadge").hide();
                        }
                    }
                }
            });
        }

        function markAsRead(id, element) {
            if (id === 0 || $(element).hasClass("opacity-50")) return;

            $.ajax({
                url: `https://localhost:7113/api/Notifications/${id}/read`,
                method: "PUT",
                success: function() {
                    $(element).addClass("opacity-50");
                    $(element).find(".icon-circle").removeClass("bg-primary").addClass("bg-secondary");

                    if (unreadCount > 0) {
                        unreadCount--;
                        if (unreadCount === 0) {
                            $("#notificationBadge").hide();
                        } else {
                            $("#notificationBadge").text(unreadCount > 9 ? "9+" : unreadCount);
                        }
                    }
                }
            });
        }

        $(document).ready(function () {
            if (typeof jwtToken !== 'undefined' && jwtToken !== null && jwtToken !== "") {

                loadInitialNotifications();

                // SignalR Bağlantısı
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("https://localhost:7113/notificationHub", {
                        accessTokenFactory: () => jwtToken
                    })
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveNotification", function (message) {
                    addNotificationToBell(message, 0);

                    let audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3');
                    audio.volume = 0.5;
                    audio.play().catch(e => console.log("Ses çalınamadı", e));

                    Swal.fire({
                        toast: true,
                        position: 'bottom-end',
                        showConfirmButton: false,
                        timer: 8000,
                        timerProgressBar: true,
                        background: $('body').hasClass('dark-mode') ? '#1a1a1c' : '#0a2896',
                        color: '#fff',
                        icon: 'info',
                        iconColor: '#ffc107',
                        title: 'Yeni Bildirim!',
                        text: message,
                        showCloseButton: true
                    });
                });

                connection.start()
                    .then(() => console.log("🟢 SignalR Canlı Bağlantısı Kuruldu!"))
                    .catch(err => console.error("🔴 SignalR Bağlantı Hatası: ", err));
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>